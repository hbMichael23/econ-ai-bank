# ============================================================
# Supabase Edge Function: ai
# 复制为 supabase/.env.local 或使用 supabase secrets set，绝不要提交真实 key。
# ============================================================

# Chat：任意 OpenAI-compatible API（DeepSeek / OpenAI / SiliconFlow / 阿里百炼等）
AI_CHAT_BASE_URL=https://api.deepseek.com/v1
AI_CHAT_API_KEY=sk-your-chat-key
AI_CHAT_MODEL=deepseek-chat

# Embedding：必须输出 1024 维，和 SQL 的 vector(1024) 对齐
# SiliconFlow 的 BAAI/bge-m3 是 1024 维；也可换其他 1024 维模型。
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_API_KEY=sk-your-embedding-key
AI_EMBEDDING_MODEL=BAAI/bge-m3

# 可选：限制 Edge Function CORS 来源，例如 https://your-project.pages.dev
# AI_ALLOWED_ORIGIN=https://your-project.pages.dev
